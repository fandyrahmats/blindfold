# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic).
# Production: reCAPTCHA Enterprise site key registered for your hosting domain.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Alternative: a classic reCAPTCHA v3 site key (used only if the Enterprise key is empty).
VITE_RECAPTCHA_V3_SITE_KEY=
# Local development only: leave empty to auto-generate a debug token in the
# browser console, or paste a token you registered in Security > App Check.
# Never commit this value.
VITE_APPCHECK_DEBUG_TOKEN=

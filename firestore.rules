rules_version = '2';

// Blindfold stores only blindfolded threads in Firestore. The vault that maps
// placeholders back to real values never leaves the browser, so nothing here
// can reveal a protected value even to the project owner.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validThread(d) {
      return d.keys().hasOnly(['title', 'maskedDocument', 'protectedValues', 'turns', 'updatedAt', 'serverTime'])
        && d.keys().hasAll(['title', 'maskedDocument', 'protectedValues', 'turns', 'updatedAt', 'serverTime'])
        && d.title is string && d.title.size() <= 120
        && d.maskedDocument is string && d.maskedDocument.size() <= 250000
        && d.protectedValues is int && d.protectedValues >= 0
        && d.turns is list && d.turns.size() <= 30
        && d.updatedAt is number
        && d.serverTime == request.time;
    }

    match /users/{uid}/threads/{threadId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validThread(request.resource.data);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
